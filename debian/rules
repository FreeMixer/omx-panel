#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Pau Aliagas <linuxnow@gmail.com>

%:
	dh $@

# npm ci fetches typescript (the build) and ajv (the validator, installed with the package); the vendored source
# tarball (tools/vendored-source.sh) already holds them, for a build with no registry
override_dh_auto_build:
	test -d node_modules || npm ci --no-audit --no-fund
	dh_auto_build

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	make test
endif

override_dh_auto_install:
	dh_auto_install -- PREFIX=/usr BINDIR=/usr/bin DATADIR=/usr/share UNITDIR=/usr/lib/systemd/system SYSCONFDIR=/etc
	# the vendored modules' lint and VCS dotfiles are theirs, not the package's: lintian refuses .eslintrc.yml
	find debian/omx-panel/usr/share/omx-panel -path '*/node_modules/*' -name '.*' -type f -delete

# the sync units are installed, never enabled or started by the package: `systemctl enable omx-modgui-sync` (and
# omx-complement-sync) is the choice; so an upgrade has nothing of ours to stop either, and on a host that never had the
# unit the stop only prints an error
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start --no-stop-on-upgrade
