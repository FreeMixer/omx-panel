{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tools/**/*.mjs",
    "lib/**/*.mjs",
    "bin/**/*.mjs"
  ],
  "exclude": [
    "tools/copy-data.mjs",
    "tools/check-spdx.mjs",
    "tools/check-public-sources.mjs"
  ]
}
