    [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 49 ;
        lv2:symbol "b8_on" ;
        lv2:name "Band 8 On" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
        pg:group <urn:openmixer:eq8#bands>
    ] ,
    [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 50 ;
        lv2:symbol "enabled" ;
        lv2:name "Enabled" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:designation lv2:enabled ;
        lv2:portProperty lv2:toggled
    ] ,
    [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 51 ;
        lv2:symbol "latency" ;
        lv2:name "Latency" ;
        lv2:designation lv2:latency ;
        lv2:portProperty lv2:reportsLatency , lv2:integer ;
        units:unit units:frame
    ] .

<urn:openmixer:eq8#bands>
    a pg:Group ;
    lv2:symbol "bands" ;
    lv2:displayPriority 30 ;
    rdfs:label "Bands" .

<urn:openmixer:eq8#hpf>
    a pg:Group ;
    lv2:symbol "hpf" ;
    lv2:displayPriority 20 ;
    rdfs:label "HPF" .

<urn:openmixer:eq8#lpf>
    a pg:Group ;
    lv2:symbol "lpf" ;
    lv2:displayPriority 10 ;
    rdfs:label "LPF" .

<urn:openmixer:unit#dBoct>
    a units:Unit ;
    rdfs:label "decibels per octave" ;
    units:render "%f dB/oct" ;
    units:symbol "dB/oct" .
