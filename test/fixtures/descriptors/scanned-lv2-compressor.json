{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 2.15.0"
  },
  "origin": "scanned",
  "plugin": {
    "id": "urn:example:compressor",
    "format": "lv2",
    "uri": "urn:example:compressor",
    "name": "Example Compressor",
    "vendor": "example",
    "version": "0.3.1",
    "features": ["audio-effect"]
  },
  "controls": [
    {
      "id": "threshold",
      "name": "Threshold",
      "kind": "travel",
      "travel": { "min": -60, "max": 0, "unit": "dB", "default": -20, "scale": "linear" },
      "group": ["Detector"],
      "meaning": "threshold",
      "source": { "from": "compressor.lv2/compressor.ttl#threshold" }
    },
    {
      "id": "ratio",
      "name": "Ratio",
      "kind": "travel",
      "travel": { "min": 1, "max": 20, "unit": "", "default": 4, "scale": "log" },
      "group": ["Detector"],
      "meaning": "ratio",
      "source": { "from": "compressor.lv2/compressor.ttl#ratio" }
    },
    {
      "id": "release_beats",
      "name": "Release (beats)",
      "kind": "travel",
      "travel": { "min": 0.25, "max": 4, "unit": "unknown", "default": 1, "scale": "linear" },
      "meaning": "unknown",
      "source": { "from": "compressor.lv2/compressor.ttl#release_beats" }
    },
    {
      "id": "makeup",
      "name": "Makeup",
      "kind": "travel",
      "travel": { "min": 0, "max": 24, "unit": "dB", "default": 0, "scale": "linear" },
      "meaning": "unknown",
      "source": { "from": "compressor.lv2/compressor.ttl#makeup" }
    },
    {
      "id": "enable",
      "name": "Enable",
      "kind": "toggle",
      "default": true,
      "meaning": "unknown",
      "source": { "from": "compressor.lv2/compressor.ttl#enable" }
    },
    {
      "id": "gr",
      "name": "Gain reduction",
      "kind": "travel",
      "travel": { "min": 0, "max": 40, "unit": "dB", "scale": "linear" },
      "readonly": true,
      "meaning": "unknown",
      "source": { "from": "compressor.lv2/compressor.ttl#gr" }
    }
  ],
  "ports": [
    { "id": "main_in", "name": "Input", "kind": "audio", "direction": "in", "role": "main", "channels": 2, "layout": "stereo" },
    { "id": "sidechain_in", "name": "Side-chain", "kind": "audio", "direction": "in", "role": "sidechain", "channels": 1, "layout": "mono" },
    { "id": "main_out", "name": "Output", "kind": "audio", "direction": "out", "role": "main", "channels": 2, "layout": "stereo" }
  ],
  "needs": {
    "tempo": true,
    "extensions": { "required": ["http://lv2plug.in/ns/ext/urid#map"] }
  },
  "latency": { "reports": false }
}
