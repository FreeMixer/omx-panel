{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 2.15.0"
  },
  "origin": "built",
  "plugin": {
    "id": "org.example.wrapped-synth",
    "format": "clap",
    "name": "Wrapped Synth",
    "vendor": "example",
    "version": "1.2.0",
    "features": ["instrument"]
  },
  "controls": [
    {
      "id": 10,
      "name": "cutoff",
      "kind": "travel",
      "travel": { "min": 20, "max": 20000, "unit": "Hz", "default": 1000, "scale": "log" },
      "group": ["Filter"],
      "meaning": "cutoffFrequency",
      "automatable": true
    },
    {
      "id": 11,
      "name": "resonance",
      "kind": "travel",
      "travel": { "min": 0, "max": 1, "unit": "", "default": 0.2, "scale": "linear" },
      "group": ["Filter"],
      "meaning": "resonance",
      "automatable": true
    },
    {
      "id": 20,
      "name": "attack",
      "kind": "travel",
      "travel": { "min": 0, "max": 5000, "unit": "ms", "default": 5, "scale": "log" },
      "group": ["Envelope"],
      "meaning": "attack",
      "automatable": true
    },
    {
      "id": 21,
      "name": "glide",
      "kind": "travel",
      "travel": { "min": 0, "max": 1, "unit": "unknown", "default": 0, "scale": "unknown" },
      "meaning": "unknown",
      "automatable": true
    },
    {
      "id": 30,
      "name": "waveform",
      "kind": "choice",
      "ids": ["sine", "square", "saw"],
      "labels": ["Sine", "Square", "Saw"],
      "values": [0, 1, 2],
      "default": "saw",
      "group": ["Oscillator"]
    },
    {
      "id": 31,
      "name": "pulseWidth",
      "kind": "travel",
      "travel": { "min": 0.05, "max": 0.95, "unit": "", "default": 0.5, "scale": "linear" },
      "group": ["Oscillator"],
      "when": { "control": "waveform", "is": "square" }
    },
    {
      "id": 40,
      "name": "panic",
      "kind": "trigger",
      "automatable": false
    },
    {
      "id": 41,
      "name": "voicesActive",
      "kind": "travel",
      "travel": { "min": 0, "max": 16, "step": 1, "unit": "", "scale": "stepped" },
      "readonly": true,
      "hidden": true
    }
  ],
  "ports": [
    { "id": 0, "name": "Notes", "kind": "note", "direction": "in", "dialects": ["clap", "midi"] },
    { "id": 0, "name": "Output", "kind": "audio", "direction": "out", "role": "main", "channels": 2, "layout": "stereo" }
  ],
  "instrument": { "voices": 16, "polyphonic": true },
  "needs": {
    "transport": true,
    "tempo": true,
    "extensions": { "required": ["clap.note-ports"], "optional": ["clap.voice-info"] }
  },
  "latency": { "reports": false },
  "source": { "from": "build/wrapped-synth.clap#clap_entry" }
}
