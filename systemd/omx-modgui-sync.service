[Unit]
Description=MOD GUIs from omx-panel for LV2 plugins that ship none
# After plugin-qualify's sync, which writes the descriptors this reads
After=local-fs.target plugin-qualify-sync.service
ConditionPathExists=/usr/bin/omx-panel

[Service]
# Not enabled by the package: `systemctl enable omx-modgui-sync` turns it on. Enabled, it runs at boot and each time
# plugin-qualify-sync starts (WantedBy below), after that sync finishes, so a plugin installed, upgraded or removed
# is followed by its GUI. The first run scans every plugin without a MOD GUI; later runs only check. The
# directories are set in /etc/omx/modgui-sync.conf.
Type=oneshot
EnvironmentFile=-/etc/omx/modgui-sync.conf
ExecStart=/usr/bin/omx-modgui-sync
Nice=19
IOSchedulingClass=idle
CPUQuota=100%
MemoryMax=1G
TasksMax=64
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target plugin-qualify-sync.service
