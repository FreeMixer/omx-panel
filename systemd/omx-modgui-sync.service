[Unit]
Description=MOD GUIs from omx-panel for LV2 plugins that ship none
After=local-fs.target
ConditionPathExists=/usr/bin/omx-panel

[Service]
# Not enabled by the package: `systemctl enable omx-modgui-sync` turns it on, and the apt hook
# (/etc/apt/apt.conf.d/80omx-modgui-sync) then refreshes it after each apt run. The first run scans every
# plugin without a MOD GUI; later runs only check. The directories are set in /etc/omx/modgui-sync.conf.
Type=oneshot
EnvironmentFile=-/etc/omx/modgui-sync.conf
ExecStart=/usr/bin/omx-modgui-sync
Nice=19
IOSchedulingClass=idle
