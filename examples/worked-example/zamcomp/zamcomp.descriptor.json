  "plugin": {"id": "urn:zamaudio:ZamComp", "format": "lv2", "uri": "urn:zamaudio:ZamComp", "name": "ZamComp", "vendor": "Damien Zammit", "doc": "A powerful mono compressor strip. Adds real beef to a kick or snare drum with the right settings.", "features": ["audio-effect"]},
